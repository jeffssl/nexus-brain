Project NexusLearning {
  database_type: 'PostgreSQL'
  Note: '''
    Aprendiendo a diseñar desde cero
  '''
}

// Empezaremos a escribir nuestras tablas aquí abajo...

// SYSTEM (Infraestructura del Sistema)
Table system.users {
  user_id uuid [pk, default: `uuid_generate_v7()`, note: 'UUID v7 para garantizar unicidad global.']
  username varchar(100) [not null, unique]
  email varchar(200) [not null, unique]
  password_hash varchar(250) [note: 'Hash seguro o null si usa External Provider.']
  full_name varchar(200) [not null]
  user_type varchar(30) [not null, note: 'ADMIN, OPERATOR, DOCTOR, PATIENT']
  //AUDITORIA
  created_at timestamptz [not null, default: 'now()']
  created_by uuid [ref: > system.users.user_id]
  updated_at timestamptz
  deleted_at timestamptz
  
  Indexes {
    (email) [unique, note: 'Parcial: WHERE deleted_at IS NULL']
    (user_type)
  }
}

Table organization.organizations {
  organization_id uuid [pk, default: `uuid_generate_v7()`, note: 'UUID v7. Representa al Tenant princimal (hospital / clinica).']
  legal_name varchar(200) [not null]
  trade_name varchar(200)
  tax_id varchar(30) [unique, note: 'RUC o NIT']
  website varchar(200)
  is_active boolean [not null, default: true]
  // Auditoría
  created_at timestamptz [not null, default: 'now()']
  updated_at timestamptz
  deleted_at timestamptz
}

Table organization.locations {
  location_id int [pk, note: 'GENERATED ALWAYS AS IDENTITY']
  organization_id uuid [not null, ref: > organization.organizations.organization_id]
  // El corazón del SaaS
  tenant_id uuid [not null, ref: > organization.organizations.organization_id, note: 'Llave para políticas de seguridad (RLS)'] 
  name varchar(200) [not null, note: 'Ej. Sede Norte, Laboratorio Central.']
  code varchar(50) [note: 'Un código interno rápido, ej: SDN-01']
  is_head_office boolean [not null, default: false, note: '¿Es la matriz?']
  timezone varchar(50) [not null, default: 'America/Guayaquil']
  is_active boolean [not null, default: true]
  
  // Auditoría
  created_at timestamptz [not null, default: 'now()']
  updated_at timestamptz
  deleted_at timestamptz
  
  Indexes {
    (organization_id, code) [unique, note: 'El código debe ser único DENTRO de la misma organización']
  }
}

//////////////////////////////////////////////////////
//  PRACTITIONER (Profesionales de Salud - FHIR)
//////////////////////////////////////////////////////

Table practitioner.practitioners {
  practitioner_id uuid [pk, default: `uuid_generate_v7()`]
  
  // ¡Otra vez el corazón del SaaS!
  tenant_id uuid [not null, ref: > organization.organizations.organization_id, note: 'Aislamiento RLS por Tenant']
  
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  document_number varchar(30) [not null, note: 'Cédula, DNI o Pasaporte']
  medical_license varchar(50) [unique, note: 'Registro Médico / Colegiatura']
  
  // Relación con el usuario del sistema (Si el médico tiene login)
  user_id uuid [ref: > system.users.user_id, note: 'Opcional: Solo si el médico usa la plataforma']
  
  is_active boolean [not null, default: true]
  
  // Auditoría
  created_at timestamptz [not null, default: 'now()']
  updated_at timestamptz
  deleted_at timestamptz
  
  Indexes {
    (last_name, first_name) [note: 'Índice para búsquedas rápidas por apellido y nombre']
    (is_active)
  }
}

//////////////////////////////////////////////////////
//  PATIENT (Pacientes - FHIR)
//////////////////////////////////////////////////////

Table patient.patients {
  patient_id uuid [pk, default: `uuid_generate_v7()`]
  tenant_id uuid [not null, ref: > organization.organizations.organization_id, note: 'Aislamiento RLS por Tenant']
  
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  document_number varchar(30) [not null, note: 'Cédula de identidad']
  birth_date date
  gender varchar(20) [note: 'MALE, FEMALE, OTHER']
  
  // Si el paciente tiene acceso web para ver sus resultados/citas
  user_id uuid [ref: > system.users.user_id]
  
  is_active boolean [not null, default: true]
  
  // Auditoría
  created_at timestamptz [not null, default: 'now()']
  updated_at timestamptz
  deleted_at timestamptz
  
  Indexes {
    (document_number) [unique, note: 'Parcial: WHERE deleted_at IS NULL']
    (last_name, first_name)
  }
}


//////////////////////////////////////////////////////
//  SCHEDULING & APPOINTMENTS (Citas - FHIR)
//////////////////////////////////////////////////////

Table scheduling.slots {
  slot_id bigint [pk, note: 'GENERATED ALWAWS AS IDENTITY']
  tenant_id uuid [not null, ref: > organization.organizations.organization_id, note: 'Aislamiento RLS por Tenant']
  practitioner_id uuid [not null, ref: > practitioner.practitioners.practitioner_id]
  location_id int [not null, ref: > organization.locations.location_id]
  slot_start_at timestamptz [not null]
  slot_end_at timestamptz [not null]
  // Concurrencia (Optimistic Locking)
  reservation_status varchar(20) [not null, default: 'OPEN', note: 'OPEN, HELD, BOOKED']
  version int [not null, default: 1, note: 'Previene que 2 pacientes tomen el slot al milisegundo exacto']
  
  created_at timestamptz [not null, default: 'now()']

}


Table appointment.appointments {
  appointment_id uuid [pk, default: `uuid_generate_v7()`]
  tenant_id uuid [not null, ref: > organization.organizations.organization_id, note: 'RLS']
  appointment_number varchar(50) [not null, unique, note: 'Código legible para el paciente, ej: CITA-001']
  
  patient_id uuid [not null, ref: > patient.patients.patient_id]
  practitioner_id uuid [not null, ref: > practitioner.practitioners.practitioner_id]
  
  slot_id bigint [not null, unique, ref: > scheduling.slots.slot_id, note: 'Una cita ocupa exactamente UN slot']
  
  appointment_date date [not null]
  status_code varchar(30) [not null, note: 'CONFIRMED, CANCELLED, COMPLETED']
  
  // Auditoría
  version int [not null, default: 1]
  created_at timestamptz [not null, default: 'now()']
  updated_at timestamptz
}

